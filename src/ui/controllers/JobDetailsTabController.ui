      <set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignTop</set>
     </property>
    </widget>
   </item>
   <item row="4" column="1">
    <widget class="QComboBox" name="type">
     <property name="toolTip">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Select job type:&lt;br/&gt;- &lt;span style=&quot; font-weight:700;&quot;&gt;mount&lt;/span&gt;: connect the remote folder to this pc and access it like a normal folder;&lt;br/&gt;- &lt;span style=&quot; font-weight:700;&quot;&gt;copy&lt;/span&gt;: copy files between two folders;&lt;br/&gt;- &lt;span style=&quot; font-weight:700;&quot;&gt;sync&lt;/span&gt;: ensure two folders are exacly the same by copying new and modified files, and deleting files in the destination folder if they're not present in the source folder. This is often referred to as one-way synchronization.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
     <property name="currentIndex">
      <number>0</number>
     </property>
     <property name="maxVisibleItems">
      <number>4</number>
     </property>
     <property name="maxCount">
      <number>4</number>
     </property>
     <item>
      <property name="text">
       <string>mount</string>
      </property>
     </item>
     <item>
      <property name="text">
       <string>sync</string>
      </property>
     </item>
     <item>
      <property name="text">
       <string>copy</string>
      </property>
     </item>
    </widget>
   </item>
   <item row="6" column="1">
    <layout class="QHBoxLayout" name="localLayout">
     <item>
      <widget class="QLineEdit" name="local">
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;For &lt;span style=&quot; font-weight:700;&quot;&gt;mount&lt;/span&gt; jobs, specify either:&lt;br/&gt;- an empty local folder (should be empty), e.g., &amp;quot;C:\Users\Desktop\My Folder&amp;quot;)&lt;br/&gt;- a new drive letter (e.g., &amp;quot;X\&amp;quot;)&lt;br/&gt;- a new network mount location (e.g., &amp;quot;\\allas\folder&amp;quot;)&lt;/p&gt;&lt;p&gt;For &lt;span style=&quot; font-weight:700;&quot;&gt;copy and sync &lt;/span&gt;jobs, specify an &lt;span style=&quot; font-weight:700;&quot;&gt;existing&lt;/span&gt; folder in the local pc.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="placeholderText">
        <string>Local folder, new drive (e.g., X:\) or network (e.g., \\allas\folder)</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QToolButton" name="localButton">
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;For &lt;span style=&quot; font-weight:700;&quot;&gt;mount&lt;/span&gt; jobs, specify either:&lt;br/&gt;- an empty local folder (should be empty), e.g., &amp;quot;C:\Users\Desktop\My Folder&amp;quot;)&lt;br/&gt;- a new drive letter (e.g., &amp;quot;X\&amp;quot;)&lt;br/&gt;- a new network mount location (e.g., &amp;quot;\\allas\folder&amp;quot;)&lt;/p&gt;&lt;p&gt;For &lt;span style=&quot; font-weight:700;&quot;&gt;copy and sync &lt;/span&gt;jobs, specify an &lt;span style=&quot; font-weight:700;&quot;&gt;existing&lt;/span&gt; folder in the local pc.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="text">
        <string>...</string>
       </property>
      </widget>
     </item>
